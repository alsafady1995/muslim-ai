# Edge Function secrets. Set in production with:
#   supabase secrets set --env-file supabase/.env.production
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.

ANTHROPIC_API_KEY=sk-ant-...
# Free users: Haiku 5.5 (~$0.001/answer). Premium: Sonnet 5.5 (~$0.02/answer). See BLOCKERS.md section 4.
# Premium falls back to CLAUDE_MODEL when its monthly AI budget is nearly used.
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_MODEL_PREMIUM=claude-sonnet-5-5
CLAUDE_EFFORT=low

# Unit costs counted against each user's AI budget (Claude is priced per token in _shared/ai_cost.ts).
# Budget sizes live in the ai_budget_settings table, not here.
ASR_COST_PER_MINUTE_USD=0.001
EMBEDDING_COST_PER_CALL_USD=0.00002

VOYAGE_API_KEY=pa-...
VOYAGE_MODEL=voyage-3.5

ASR_SERVICE_URL=https://muslim-ai-asr-xxxxx.a.run.app
ASR_SERVICE_TOKEN=generate-64-random-chars

# Paste the same value into RevenueCat > Webhooks > Authorization header
REVENUECAT_WEBHOOK_AUTH=generate-64-random-chars
REVENUECAT_ENTITLEMENT_ID=premium

POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://eu.i.posthog.com

DEFAULT_TRANSLATION_ID=20
DEFAULT_TAFSIR_AR_ID=1
DEFAULT_TAFSIR_EN_ID=2
